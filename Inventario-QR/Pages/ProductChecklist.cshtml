@page "{id:int}"
@model Inventario_QR.Pages.ProductChecklistModel
@{
    ViewData["Title"] = "Asignación de Persona y Complementos: " + Model.Product?.ProductName;
}

<div class="container-fluid mt-3 mb-5 px-2 px-md-3">
    <!-- ENCABEZADO GLOBAL -->
    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
        <div class="card-header bg-success text-white d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center py-2 px-3 gap-2">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5 text-wrap">👥 Asignación de Persona y Complementos: @Model.Product?.ProductName</h5>
            <span class="badge bg-light text-dark fs-6 text-nowrap align-self-start align-self-sm-center">Código: @Model.Product?.Code</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- CARACTERÍSTICAS PRINCIPALES DEL EQUIPO -->
    @{
        var mainCharacteristics = Model.AllChecklistItems.Where(x => !x.Complement).ToList();
        var mainWithValues = mainCharacteristics.Where(x => !string.IsNullOrWhiteSpace(x.DetailsValue)).ToList();
    }

    <div class="card bg-light border-0 p-3 mb-3 shadow-sm rounded-3">
        <h6 class="text-success fw-bold mb-2 fs-6">💻 Características Principales del Equipo:</h6>
        @if (mainWithValues.Any())
        {
            <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 align-items-stretch align-items-sm-center">
                @foreach (var mainItem in mainWithValues)
                {
                    <span class="badge bg-white text-dark border p-2 shadow-sm text-wrap text-start">
                        <strong class="text-success">@mainItem.DetailName:</strong> @mainItem.DetailsValue
                    </span>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-0"><em>No tiene características principales registradas.</em></p>
        }
    </div>

    <form method="post" asp-page-handler="SaveAssign">
        <input type="hidden" name="id" value="@Model.Id" />

        <!-- CONTENEDOR PRINCIPAL RESPONSIVO (2 Columnas en Escritorio | 1 Columna en Celular) -->
        <div class="row g-3 align-items-start">

            <!-- COLUMNA IZQUIERDA -->
            <div class="col-12 col-xl-6">

                <div class="mb-3">
                    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">← Volver al Panel</a>
                </div>

                <!-- Tarjeta 1: Datos de Asignación y Destino -->
                <div class="card bg-light border-0 p-3 mb-3 shadow-sm rounded-3">
                    <h6 class="mb-3 text-success fw-bold fs-6">👤 Datos de Asignación y Destino</h6>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-bold small mb-1">Personal Asignado</label>
                            <div class="input-group input-group-sm">
                                <input class="form-control" list="personsOptions" id="selectedPersonInput" value="@Model.AssignedPersonDisplayValue" placeholder="🔍 Buscar por nombre o CI..." required />
                                <button type="button" id="btnPersonAction" class="btn btn-outline-success fw-bold px-3" data-bs-toggle="modal" data-bs-target="#registerPersonModal" title="Registrar / Modificar">
                                    ➕
                                </button>
                                <datalist id="personsOptions">
                                    @foreach (var p in Model.AllPersons)
                                    {
                                        <option value="@p.LastName (CI: @p.Identification)"
                                                data-id="@p.Id"
                                                data-lastname="@p.LastName"
                                                data-identification="@p.Identification"
                                                data-numbers="@p.Numbers"
                                                data-positionid="@p.PositionId"
                                                data-dependenceid="@p.DependenceId"
                                                data-active="@p.Active">
                                        </option>
                                    }
                                </datalist>
                                <input type="hidden" asp-for="SelectedPersonId" id="SelectedPersonId" />
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Localization" class="form-label fw-bold text-success small mb-1">📍 Departamento de Destino</label>
                            <select asp-for="Localization" class="form-select form-select-sm" required>
                                <option value="">-- Seleccione --</option>
                                @foreach (var depto in Model.DepartamentosBolivia)
                                {
                                    <option value="@depto">@depto</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="AssignmentComment" class="form-label fw-bold text-success small mb-1">💬 Comentario de Entrega / Estado de la Máquina</label>
                            <textarea asp-for="AssignmentComment" class="form-control form-control-sm" rows="2" placeholder="Ej. Equipos en perfecto estado..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta 2: Registrar Complemento / Elemento -->
                <div class="card bg-light border-0 p-3 mb-3 shadow-sm rounded-3">
                    <h6 class="mb-3 text-success fw-bold fs-6">➕ Registrar Complemento / Elemento</h6>
                    <div class="row g-2">
                        <div class="col-12">
                            <input type="text" asp-for="NewCatalogDetailName" class="form-control form-control-sm" placeholder="Nombre (Ej. Mouse, Cable HDMI)" />
                        </div>
                        <div class="col-12 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mt-2 gap-2">
                            <div class="form-check m-0">
                                <input type="checkbox" asp-for="NewCatalogIsComplement" class="form-check-input" id="isComplementCheckAssign" checked />
                                <label class="form-check-label fw-bold small" for="isComplementCheckAssign">¿Es Complemento?</label>
                            </div>
                            <button type="submit" asp-page-handler="RegisterCatalogItem" class="btn btn-sm btn-success fw-bold text-nowrap px-3 w-100 w-sm-auto">
                                + Registrar
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Botón de Guardado Principal -->
                <div class="mb-3">
                    <button type="submit" asp-page-handler="SaveAssign" class="btn @(Model.IsAlreadyAssigned ? "btn-warning text-dark" : "btn-success") fw-bold px-4 py-2 shadow-sm w-100 w-sm-auto">
                        💾 @(Model.IsAlreadyAssigned ? "Modificar Asignación" : "Guardar Asignación")
                    </button>
                </div>

            </div>

            <!-- COLUMNA DERECHA (Lista ÚNICAMENTE de Complementos) -->
            <div class="col-12 col-xl-6">
                <div class="card bg-light border-0 p-3 shadow-sm rounded-3">
                    @{
                        var complementItems = Model.AllChecklistItems.Where(x => x.Complement).ToList();
                    }
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 text-secondary fw-bold fs-6">📦 Lista de Complementos y Accesorios (@complementItems.Count)</h6>
                    </div>
                    <div class="mb-2">
                        <input type="text" id="searchFilterAssign" class="form-control form-control-sm" placeholder="🔍 Buscar complemento..." />
                    </div>

                    <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle search-table-assign bg-white mb-0 border">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 10%;" class="text-center">Seleccionar</th>
                                    <th style="width: 30%;">Elemento</th>
                                    <th style="width: 15%;">Cantidad</th>
                                    <th style="width: 33%;">Observaciones / Serie</th>
                                    <th style="width: 12%;" class="text-center">Gestión</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.AllChecklistItems.Count; i++)
                                {
                                    var item = Model.AllChecklistItems[i];

                                    @if (!item.Complement)
                                    {
                                        <input type="hidden" name="AllChecklistItems[@i].DetailsId" value="@item.DetailsId" />
                                        <input type="hidden" name="AllChecklistItems[@i].DetailName" value="@item.DetailName" />
                                        <input type="hidden" name="AllChecklistItems[@i].Complement" value="false" />
                                        <input type="hidden" name="AllChecklistItems[@i].IsSelected" value="false" />
                                        <input type="hidden" name="AllChecklistItems[@i].Amount" value="1" />
                                        <input type="hidden" name="AllChecklistItems[@i].DetailsValue" value="@item.DetailsValue" />
                                    }
                                    else
                                    {
                                        <tr class="searchable-row-assign">
                                            <td class="text-center">
                                                <input type="hidden" name="AllChecklistItems[@i].DetailsId" value="@item.DetailsId" />
                                                <input type="hidden" name="AllChecklistItems[@i].DetailName" value="@item.DetailName" />
                                                <input type="hidden" name="AllChecklistItems[@i].Complement" value="true" />

                                                <input type="checkbox" name="AllChecklistItems[@i].IsSelected" value="true" class="form-check-input checklist-checkbox" @(item.IsSelected ? "checked" : "") />
                                            </td>
                                            <td>
                                                <strong class="item-name-assign small">@item.DetailName</strong>
                                                <span class="badge bg-secondary ms-1 d-none d-sm-inline" style="font-size: 0.60rem;">(Complemento)</span>
                                            </td>
                                            <td>
                                                <input type="number" name="AllChecklistItems[@i].Amount" value="@item.Amount" class="form-control form-control-sm input-amount" min="1" style="max-width: 65px;" @(item.IsSelected ? "" : "disabled") />
                                            </td>
                                            <td>
                                                <input type="text" name="AllChecklistItems[@i].DetailsValue" value="@item.DetailsValue" class="form-control form-control-sm input-details" placeholder="Ej. Serie, marca..." @(item.IsSelected ? "" : "disabled") />
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-warning p-1 btn-edit-catalog"
                                                            data-id="@item.DetailsId"
                                                            data-name="@item.DetailName"
                                                            data-iscomplement="true"
                                                            title="Modificar">
                                                        ✏️
                                                    </button>
                                                    <button type="submit" asp-page-handler="DeleteCatalogItem" asp-route-detailId="@item.DetailsId"
                                                            class="btn btn-sm btn-outline-danger p-1"
                                                            onclick="return confirm('¿Estás seguro de eliminar este elemento del catálogo?');"
                                                            title="Eliminar">
                                                        🗑️
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<!-- MODAL PRINCIPAL: REGISTRO / EDICIÓN DE PERSONA -->
<div class="modal fade" id="registerPersonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="personFormModal" asp-page-handler="RegisterPerson">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" id="ModalPersonId" asp-for="ModalPersonId" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fs-6" id="personModalTitle">Registrar / Modificar Persona</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Apellido / Nombre</label>
                        <input type="text" asp-for="ModalNewPersonLastName" id="ModalNewPersonLastName" class="form-control form-control-sm" placeholder="Ej. Pérez" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Identificación (CI)</label>
                        <input type="text" asp-for="ModalNewPersonIdentification" id="ModalNewPersonIdentification" class="form-control form-control-sm" placeholder="Ej. 1234567" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Número / Teléfono</label>
                        <input type="text" asp-for="ModalNewPersonNumbers" id="ModalNewPersonNumbers" class="form-control form-control-sm" placeholder="Ej. 70000000" />
                    </div>

                    <!-- CARGO -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Cargo (Position)</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="ModalNewPersonPositionId" id="ModalNewPersonPositionId" class="form-select">
                                <option value="">-- Seleccionar Cargo --</option>
                                @foreach (var pos in Model.AllPositions)
                                {
                                    <option value="@pos.Id" data-name="@pos.PositionName">@pos.PositionName</option>
                                }
                            </select>
                            <button type="button" id="btnOpenPositionModal" class="btn btn-outline-success fw-bold" title="Nuevo Cargo">
                                ➕
                            </button>
                            <button type="button" id="btnEditPositionModal" class="btn btn-outline-warning fw-bold" title="Modificar Cargo Seleccionado" style="display:none;">
                                ✏️
                            </button>
                        </div>
                    </div>

                    <!-- DEPENDENCIA -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Área / Dependencia (Dependence)</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="ModalNewPersonDependenceId" id="ModalNewPersonDependenceId" class="form-select">
                                <option value="">-- Seleccionar Dependencia --</option>
                                @foreach (var dep in Model.AllDependences)
                                {
                                    <option value="@dep.Id" data-name="@dep.DependenceName">@dep.DependenceName</option>
                                }
                            </select>
                            <button type="button" id="btnOpenDependenceModal" class="btn btn-outline-success fw-bold" title="Nueva Dependencia">
                                ➕
                            </button>
                            <button type="button" id="btnEditDependenceModal" class="btn btn-outline-warning fw-bold" title="Modificar Dependencia Seleccionada" style="display:none;">
                                ✏️
                            </button>
                        </div>
                    </div>

                    <div class="form-check mb-2">
                        <input type="checkbox" asp-for="ModalNewPersonIsActive" id="ModalNewPersonIsActive" class="form-check-input" checked />
                        <label class="form-check-label fw-bold small" for="ModalNewPersonIsActive">Activo</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-success" id="btnPersonModalSubmit">Guardar Persona</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SUB-MODAL: CARGO -->
<div class="modal fade" id="positionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title" id="positionModalTitle">Nuevo Cargo</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="SubModalPositionId" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Nombre del Cargo</label>
                    <input type="text" id="SubModalPositionName" class="form-control form-control-sm" placeholder="Ej. Administrador" />
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-sm btn-secondary" id="btnClosePositionModal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-success" id="btnSavePositionAjax">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- SUB-MODAL: DEPENDENCIA -->
<div class="modal fade" id="dependenceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title" id="dependenceModalTitle">Nueva Dependencia</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="SubModalDependenceId" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Nombre de la Dependencia</label>
                    <input type="text" id="SubModalDependenceName" class="form-control form-control-sm" placeholder="Ej. Sistemas" />
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-sm btn-secondary" id="btnCloseDependenceModal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-success" id="btnSaveDependenceAjax">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const personInput = document.getElementById('selectedPersonInput');
        const personIdInput = document.getElementById('SelectedPersonId');
        const datalist = document.getElementById('personsOptions');
        const btnPersonAction = document.getElementById('btnPersonAction');

        const personModalEl = document.getElementById('registerPersonModal');
        const personModal = new bootstrap.Modal(personModalEl);

        // Función para actualizar el botón compacto (➕ o ✏️) según el texto
        function updatePersonButtonState() {
            const val = personInput.value.trim();
            let foundOpt = null;

            if (val) {
                const options = datalist.querySelectorAll('option');
                options.forEach(opt => {
                    if (opt.value === val) {
                        foundOpt = opt;
                    }
                });
            }

            if (foundOpt) {
                personIdInput.value = foundOpt.getAttribute('data-id');
                btnPersonAction.innerHTML = '✏️';
                btnPersonAction.className = 'btn btn-outline-warning text-dark fw-bold px-3';
                btnPersonAction.title = 'Modificar Persona';
            } else {
                personIdInput.value = '';
                btnPersonAction.innerHTML = '➕';
                btnPersonAction.className = 'btn btn-outline-success fw-bold px-3';
                btnPersonAction.title = 'Registrar Nueva Persona';
            }
        }

        if (personInput && btnPersonAction) {
            personInput.addEventListener('input', updatePersonButtonState);
            personInput.addEventListener('change', updatePersonButtonState);
            updatePersonButtonState(); // Estado inicial

            // Al hacer clic en el botón (➕ o ✏️)
            btnPersonAction.addEventListener('click', function () {
                const val = personInput.value.trim();
                let matchedOption = null;

                if (val) {
                    const options = datalist.querySelectorAll('option');
                    options.forEach(opt => {
                        if (opt.value === val) {
                            matchedOption = opt;
                        }
                    });
                }

                const posSelect = document.getElementById('ModalNewPersonPositionId');
                const depSelect = document.getElementById('ModalNewPersonDependenceId');

                if (matchedOption) {
                    // Modo Modificar: Llena los datos y selecciona los cargos/dependencias correctos
                    document.getElementById('ModalPersonId').value = matchedOption.getAttribute('data-id');
                    document.getElementById('ModalNewPersonLastName').value = matchedOption.getAttribute('data-lastname') || '';
                    document.getElementById('ModalNewPersonIdentification').value = matchedOption.getAttribute('data-identification') || '';
                    document.getElementById('ModalNewPersonNumbers').value = matchedOption.getAttribute('data-numbers') || '';
                    document.getElementById('ModalNewPersonIsActive').checked = matchedOption.getAttribute('data-active') === 'True';
                    document.getElementById('personModalTitle').innerText = 'Modificar Persona';

                    // Asignar Cargo y disparar evento change para mostrar el lápiz
                    const posId = matchedOption.getAttribute('data-positionid');
                    posSelect.value = (posId && posId !== '') ? posId : '';
                    posSelect.dispatchEvent(new Event('change'));

                    // Asignar Dependencia y disparar evento change para mostrar el lápiz
                    const depId = matchedOption.getAttribute('data-dependenceid');
                    depSelect.value = (depId && depId !== '') ? depId : '';
                    depSelect.dispatchEvent(new Event('change'));
                } else {
                    // Modo Nuevo: Limpia todo el modal
                    document.getElementById('ModalPersonId').value = '';
                    document.getElementById('ModalNewPersonLastName').value = '';
                    document.getElementById('ModalNewPersonIdentification').value = '';
                    document.getElementById('ModalNewPersonNumbers').value = '';

                    posSelect.value = '';
                    posSelect.dispatchEvent(new Event('change'));

                    depSelect.value = '';
                    depSelect.dispatchEvent(new Event('change'));

                    document.getElementById('ModalNewPersonIsActive').checked = true;
                    document.getElementById('personModalTitle').innerText = 'Registrar Nueva Persona';
                }
            });
        }

            // --- Tus modales de Cargo y Dependencia intactos ---
            document.getElementById('btnOpenPositionModal').addEventListener('click', function () {
                document.getElementById('SubModalPositionId').value = '';
                document.getElementById('SubModalPositionName').value = '';
                document.getElementById('positionModalTitle').innerText = 'Nuevo Cargo';
                personModal.hide();
                positionModal.show();
            });

            const selectPosition = document.getElementById('ModalNewPersonPositionId');
            const btnEditPosition = document.getElementById('btnEditPositionModal');
            if(selectPosition && btnEditPosition) {
                selectPosition.addEventListener('change', function() {
                    btnEditPosition.style.display = this.value ? 'inline-block' : 'none';
                });
                btnEditPosition.addEventListener('click', function() {
                    const opt = selectPosition.options[selectPosition.selectedIndex];
                    document.getElementById('SubModalPositionId').value = selectPosition.value;
                    document.getElementById('SubModalPositionName').value = opt.getAttribute('data-name') || '';
                    document.getElementById('positionModalTitle').innerText = 'Modificar Cargo';
                    personModal.hide();
                    positionModal.show();
                });
            }

            document.getElementById('btnClosePositionModal').addEventListener('click', function () {
                positionModal.hide();
                personModal.show();
            });

            document.getElementById('btnSavePositionAjax').addEventListener('click', function () {
                const posId = document.getElementById('SubModalPositionId').value;
                const posName = document.getElementById('SubModalPositionName').value;

                if (!posName.trim()) {
                    alert('El nombre del cargo no puede estar vacío.');
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                fetch('?handler=RegisterPosition', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token || ''
                    },
                    body: `ModalPositionId=${encodeURIComponent(posId || 0)}&NewPositionName=${encodeURIComponent(posName)}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        let select = document.getElementById('ModalNewPersonPositionId');
                        if (data.isEdit) {
                            let opt = select.querySelector(`option[value="${data.id}"]`);
                            if (opt) {
                                opt.text = data.name;
                                opt.setAttribute('data-name', data.name);
                            }
                        } else {
                            let newOpt = document.createElement('option');
                            newOpt.value = data.id;
                            newOpt.text = data.name;
                            newOpt.setAttribute('data-name', data.name);
                            select.appendChild(newOpt);
                            select.value = data.id;
                        }
                        btnEditPosition.style.display = 'inline-block';
                        positionModal.hide();
                        personModal.show();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(err => console.error(err));
            });

            document.getElementById('btnOpenDependenceModal').addEventListener('click', function () {
                document.getElementById('SubModalDependenceId').value = '';
                document.getElementById('SubModalDependenceName').value = '';
                document.getElementById('dependenceModalTitle').innerText = 'Nueva Dependencia';
                personModal.hide();
                dependenceModal.show();
            });

            const selectDependence = document.getElementById('ModalNewPersonDependenceId');
            const btnEditDependence = document.getElementById('btnEditDependenceModal');
            if(selectDependence && btnEditDependence) {
                selectDependence.addEventListener('change', function() {
                    btnEditDependence.style.display = this.value ? 'inline-block' : 'none';
                });
                btnEditDependence.addEventListener('click', function() {
                    const opt = selectDependence.options[selectDependence.selectedIndex];
                    document.getElementById('SubModalDependenceId').value = selectDependence.value;
                    document.getElementById('SubModalDependenceName').value = opt.getAttribute('data-name') || '';
                    document.getElementById('dependenceModalTitle').innerText = 'Modificar Dependencia';
                    personModal.hide();
                    dependenceModal.show();
                });
            }

            document.getElementById('btnCloseDependenceModal').addEventListener('click', function () {
                dependenceModal.hide();
                personModal.show();
            });

            document.getElementById('btnSaveDependenceAjax').addEventListener('click', function () {
                const depId = document.getElementById('SubModalDependenceId').value;
                const depName = document.getElementById('SubModalDependenceName').value;

                if (!depName.trim()) {
                    alert('El nombre de la dependencia no puede estar vacío.');
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                fetch('?handler=RegisterDependence', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token || ''
                    },
                    body: `ModalDependenceId=${encodeURIComponent(depId || 0)}&NewDependenceName=${encodeURIComponent(depName)}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        let select = document.getElementById('ModalNewPersonDependenceId');
                        if (data.isEdit) {
                            let opt = select.querySelector(`option[value="${data.id}"]`);
                            if (opt) {
                                opt.text = data.name;
                                opt.setAttribute('data-name', data.name);
                            }
                        } else {
                            let newOpt = document.createElement('option');
                            newOpt.value = data.id;
                            newOpt.text = data.name;
                            newOpt.setAttribute('data-name', data.name);
                            select.appendChild(newOpt);
                            select.value = data.id;
                        }
                        btnEditDependence.style.display = 'inline-block';
                        dependenceModal.hide();
                        personModal.show();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(err => console.error(err));
            });

                    // Habilitar / Deshabilitar los campos de Cantidad y Observaciones al marcar/desmarcar
            const checklistCheckboxes = document.querySelectorAll('.checklist-checkbox');

            checklistCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const row = this.closest('tr');
                    const amountInput = row.querySelector('.input-amount');
                    const detailsInput = row.querySelector('.input-details');

                    if (this.checked) {
                        if (amountInput) amountInput.disabled = false;
                        if (detailsInput) detailsInput.disabled = false;
                    } else {
                        if (amountInput) amountInput.disabled = true;
                        if (detailsInput) detailsInput.disabled = true;
                    }
                });
            });
        });
    </script>
}