@page
@model Inventario_QR.Pages.PrintQRsModel

@{
    ViewData["Title"] = "Impresión de etiquetas QR";
}

<style>
    .qr-print-page {
        --label-width: 3cm;
        --label-height: 3cm;
        width: 100%;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* BARRA DE CONTROLES */

    .qr-toolbar {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

        .qr-toolbar h3 {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
        }

    .qr-toolbar-description {
        color: #64748b;
        font-size: 13px;
        margin-top: 5px;
        margin-bottom: 0;
    }

    /* SELECTORES DE TAMAÑO */

    .qr-size-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 14px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #e8edf3;
    }

    .qr-size-field {
        min-width: 105px;
    }

        .qr-size-field label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #334155;
        }

        .qr-size-field input {
            width: 110px;
            max-width: 100%;
            height: 38px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            padding: 6px 10px;
            font-size: 14px;
        }

    .qr-size-presets {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

        .qr-size-presets button {
            border: 1px solid #cbd5e1;
            background: #fff;
            color: #334155;
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 12px;
            cursor: pointer;
        }

            .qr-size-presets button:hover {
                background: #eff6ff;
                border-color: #93c5fd;
            }

    .qr-size-status {
        font-size: 12px;
        color: #475569;
        margin-top: 12px;
        margin-bottom: 0;
    }

    /* VISTA PREVIA */

    .qr-preview-area {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        min-height: 180px;
        overflow: auto;
    }

    .qr-preview-heading {
        font-size: 14px;
        font-weight: 700;
        margin: 0 0 15px;
        color: #334155;
    }

    .labels-container {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 5mm;
    }

    /* ETIQUETA COMPACTA Y EQUILIBRADA */

    .qr-label-card {
        width: var(--label-width);
        height: var(--label-height);
        flex: 0 0 var(--label-width);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly; /* Distribuye el espacio de forma equilibrada y cercana */
        padding: 1.2mm;
        background: #fff;
        color: #111;
        border: 0.2mm solid #cbd5e1;
        border-radius: 1mm;
        text-align: center;
        overflow: hidden;
        box-sizing: border-box;
        break-inside: avoid;
        page-break-inside: avoid;
    }

        /* CÓDIGO DEL PRODUCTO */
        .qr-label-card .product-code {
            width: 100%;
            flex: 0 0 auto;
            font-size: calc(var(--label-width) * 0.08);
            font-weight: 700;
            line-height: 1;
            color: #1e293b;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* IMAGEN DEL CÓDIGO QR */
        .qr-label-card .qr-img {
            display: block;
            width: auto;
            height: auto;
            max-width: 88%;
            max-height: 60%;
            flex: 0 1 auto;
            object-fit: contain;
            margin: 0 auto;
        }

        /* TEXTO DEL CÓDIGO QR */
        .qr-label-card .qr-text {
            width: 100%;
            flex: 0 0 auto;
            font-size: calc(var(--label-width) * 0.072);
            font-weight: 700;
            line-height: 1;
            color: #334155;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* MARCA / LOGO SUPERVIGILANCIA */
        .qr-label-card .qr-brand {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            gap: 2px;
            width: 100%;
            margin: 0;
            font-size: calc(var(--label-width) * 0.068);
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
            overflow: hidden;
        }

        .qr-label-card .qr-brand-logo {
            display: inline-block;
            width: calc(var(--label-width) * 0.09);
            height: calc(var(--label-width) * 0.09);
            max-width: 18px;
            max-height: 18px;
            object-fit: contain;
        }

    /* MENSAJE SIN PRODUCTOS */

    .qr-empty-message {
        padding: 35px 15px;
        text-align: center;
        color: #64748b;
        width: 100%;
    }

    /* IMPRESIÓN */

    @@page {
        size: auto;
        margin: 5mm;
    }

    @@media print {
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
        }

        .no-print {
            display: none !important;
        }

        .qr-print-page {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .qr-preview-area {
            background: #fff !important;
            border: 0 !important;
            border-radius: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
        }

        .qr-preview-heading {
            display: none !important;
        }

        .labels-container {
            display: flex !important;
            flex-wrap: wrap !important;
            align-items: flex-start !important;
            align-content: flex-start !important;
            gap: 1mm !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .qr-label-card {
            border: 0.2mm solid #bbb !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            padding: 1mm !important;
        }
    }
</style>

<div class="container-fluid my-4 px-4 qr-print-page" id="qrPrintPage">

    <!-- CONTROLES -->
    <div class="qr-toolbar no-print">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3>Etiquetas QR de Inventario</h3>
                <p class="qr-toolbar-description">
                    Selecciona el tamaño de la etiqueta para vista previa e impresión.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" onclick="window.print()" class="btn btn-success fw-bold shadow-sm">
                    🖨️ Imprimir etiquetas
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary shadow-sm">
                    ← Volver al Panel
                </a>
            </div>
        </div>

        <div class="qr-size-controls">
            <div class="qr-size-field">
                <label for="labelWidth">Ancho (cm)</label>
                <input type="number" id="labelWidth" min="1.5" max="10" step="0.5" value="3" inputmode="decimal" />
            </div>

            <div class="qr-size-field">
                <label for="labelHeight">Alto (cm)</label>
                <input type="number" id="labelHeight" min="1.5" max="10" step="0.5" value="3" inputmode="decimal" />
            </div>

            <div class="qr-size-presets">
                <button type="button" data-size="1.5">1,5 × 1,5 cm</button>
                <button type="button" data-size="2">2 × 2 cm</button>
                <button type="button" data-size="3">3 × 3 cm</button>
                <button type="button" data-size="5">5 × 5 cm</button>
                <button type="button" data-size="10">10 × 10 cm</button>
            </div>
        </div>

        <p class="qr-size-status" id="qrSizeStatus" aria-live="polite">
            Tamaño actual: 3 × 3 cm.
        </p>
    </div>

    <!-- VISTA PREVIA -->
    <div class="qr-preview-area">
        <h5 class="qr-preview-heading">
            Vista previa de las etiquetas
        </h5>

        <div class="labels-container" id="labelsContainer">
            @if (Model.Products != null && Model.Products.Any())
            {
                @foreach (var item in Model.Products)
                {
                    <div class="qr-label-card">
                        <div class="product-code" title="@item.Code">
                            @item.Code
                        </div>

                        <img src="@item.QrImage" alt="Código QR de @item.ProductName" class="qr-img" />

                        <div class="qr-text" title="@item.Qr">
                            @item.Qr
                        </div>

                        <div class="qr-brand">
                            <img src="~/images/logo.png" alt="Logo SuperVigilancia" class="qr-brand-logo" />
                            <span>SuperVigilancia SRL</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="qr-empty-message">
                    No se seleccionaron elementos para imprimir.
                </div>
            }
        </div>
    </div>
</div>

<script>
    (() => {
        const page = document.getElementById('qrPrintPage');
        const widthInput = document.getElementById('labelWidth');
        const heightInput = document.getElementById('labelHeight');
        const status = document.getElementById('qrSizeStatus');
        const container = document.getElementById('labelsContainer');

        if (!page || !widthInput || !heightInput || !status || !container) {
            return;
        }

        function normalizeSize(input) {
            let value = Number.parseFloat(input.value);

            if (!Number.isFinite(value)) {
                value = 3;
            }

            value = Math.min(10, Math.max(1.5, value));
            value = Math.round(value * 2) / 2;

            input.value = value;
            return value;
        }

        function updateLabelSize() {
            const width = normalizeSize(widthInput);
            const height = normalizeSize(heightInput);

            page.style.setProperty('--label-width', width + 'cm');
            page.style.setProperty('--label-height', height + 'cm');

            const count = container.querySelectorAll('.qr-label-card').length;
            status.textContent = 'Tamaño actual: ' + width + ' × ' + height + ' cm. Cantidad: ' + count + ' etiqueta(s).';
        }

        widthInput.addEventListener('change', updateLabelSize);
        heightInput.addEventListener('change', updateLabelSize);

        widthInput.addEventListener('input', () => {
            const width = Number.parseFloat(widthInput.value);
            if (Number.isFinite(width) && width >= 1.5 && width <= 10) {
                page.style.setProperty('--label-width', width + 'cm');
            }
        });

        heightInput.addEventListener('input', () => {
            const height = Number.parseFloat(heightInput.value);
            if (Number.isFinite(height) && height >= 1.5 && height <= 10) {
                page.style.setProperty('--label-height', height + 'cm');
            }
        });

        document.querySelectorAll('[data-size]').forEach(button => {
            button.addEventListener('click', () => {
                const size = Number(button.dataset.size);
                widthInput.value = size;
                heightInput.value = size;
                updateLabelSize();
            });
        });

        window.addEventListener('beforeprint', updateLabelSize);

        updateLabelSize();
    })();
</script>