@page
@model Inventario_QR.Pages.CreateProductModel
@{
    ViewData["Title"] = "Registrar Producto";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h3 class="mb-4">Registrar Nuevo Producto</h3>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Product.Code" class="form-label">Código de Inventario</label>
                    <input asp-for="Product.Code" class="form-control" placeholder="Ej. LAP-001" required />
                    <span asp-validation-for="Product.Code" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.ProductName" class="form-label">Nombre / Descripción del Producto</label>
                    <input asp-for="Product.ProductName" class="form-control" placeholder="Ej. Laptop Lenovo ThinkPad E14" required />
                    <span asp-validation-for="Product.ProductName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Qr" class="form-label">Identificador QR Único</label>
                    <input asp-for="Product.Qr" class="form-control bg-light" readonly />
                    <small class="text-muted">Autogenerado por el sistema para la etiqueta física.</small>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Product.Active" class="form-check-input" checked />
                    <label asp-for="Product.Active" class="form-check-label">Producto Activo</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-sm">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>