@page
@model Inventario_QR.Pages.IndexModel
@{
    ViewData["Title"] = "Inventario de Activos";
}

<div class="container-fluid mt-2 px-0">
    <!-- Título y Botones -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 fs-3 fs-md-2">Panel de Inventario y Control QR</h2>
            <p class="text-muted small mb-0">Gestión de activos, códigos QR y asignaciones organizadas.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="submit" form="inventoryForm" asp-page-handler="PrintQRs" class="btn btn-dark shadow-sm w-100 w-md-auto">Generar QR en Lote</button>
        </div>
    </div>

    <!-- Buscador responsivo y Selector de Registros por Página -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-white">
        <div class="card-body p-3">
            <form method="get" id="searchForm" class="row g-3 align-items-center">
                <div class="col-12 col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">🔍</span>
                        <input type="text" id="searchTermInput" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Escribe para buscar por código, QR, producto o nombre..." autocomplete="off" />
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-3 d-flex justify-content-md-end align-items-center gap-2">
                    <label for="pageSizeSelect" class="small text-muted text-nowrap mb-0">Mostrar:</label>
                    <select id="pageSizeSelect" name="PageSize" class="form-select form-select-sm w-auto" onchange="document.getElementById('searchForm').submit();">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="30" selected="@(Model.PageSize == 30)">30</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                    <input type="hidden" name="CurrentPage" value="1" /> <!-- Reiniciar a pág 1 al cambiar tamaño -->
                </div>
            </form>
        </div>
    </div>

    <form method="post" id="inventoryForm">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-nowrap text-md-wrap">
                        <thead class="table-light text-uppercase fs-7 text-secondary">
                            <tr>
                                <th style="width: 50px;" class="text-center py-3">
                                    <input type="checkbox" id="selectAll" class="form-check-input" />
                                </th>
                                <th class="py-3">Código</th>
                                <th class="py-3">Producto</th>
                                <th class="py-3">QR Asignado</th>
                                <th class="py-3">Asignado A</th>
                                <th class="text-end py-3 pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products != null && Model.Products.Any())
                            {
                                @foreach (var item in Model.Products)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" name="SelectedProductIds" value="@item.Id" class="form-check-input productCheckbox" />
                                        </td>
                                        <td><strong class="text-primary">@item.Code</strong></td>
                                        <td class="fw-medium text-dark text-wrap" style="min-width: 180px;">@item.ProductName</td>
                                        <td>
                                            <code class="bg-light px-2 py-1 rounded text-dark border">@item.Qr</code>
                                        </td>
                                        <td>
                                            @if (item.IsAssigned)
                                            {
                                                <span class="text-success fw-semibold text-wrap" style="min-width: 150px; display: inline-block;">@item.AssignedToName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No asignado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-1 text-nowrap">
                                                <a asp-page="./ProductChecklist" asp-route-id="@item.Id" asp-route-mode="details" class="btn btn-outline-primary btn-sm px-2">Detalles</a>

                                                @if (item.IsAssigned)
                                                {
                                                    <a asp-page="./ProductChecklist" asp-route-id="@item.Id" asp-route-mode="assign" class="btn btn-success btn-sm px-2 fw-bold">Asignado</a>
                                                }
                                                else
                                                {
                                                    <a asp-page="./ProductChecklist" asp-route-id="@item.Id" asp-route-mode="assign" class="btn btn-outline-success btn-sm px-2">Asignar</a>
                                                }

                                                <a asp-page="./Visualizations" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm px-2">Ver</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <div class="py-3">
                                            <p class="mb-1 fs-5">No se encontraron productos registrados.</p>
                                            <small class="text-muted">Intente ajustando el término de búsqueda.</small>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer de la tarjeta con paginación adaptable -->
            <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 px-4 border-top gap-3">
                <span class="text-muted small text-center text-md-start">Seleccione los elementos deseados para generar etiquetas QR en lote (3x3 cm).</span>

                <nav aria-label="Navegación de páginas">
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageSize="@Model.PageSize">
                                &laquo; Anterior
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link bg-light text-dark fw-bold">
                                Página @Model.CurrentPage de @Model.TotalPages
                            </span>
                        </li>
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageSize="@Model.PageSize">
                                Siguiente &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let searchTimeout;
            const searchInput = document.getElementById('searchTermInput');
            const searchForm = document.getElementById('searchForm');

            if (searchInput && searchForm) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        searchForm.submit();
                    }, 500);
                });

                const val = searchInput.value;
                if (val) {
                    searchInput.focus();
                    searchInput.setSelectionRange(val.length, val.length);
                }
            }

            const STORAGE_KEY = 'selectedProductIds_inventory';

            function getStoredIds() {
                try {
                    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
                } catch(e) {
                    return [];
                }
            }

            function setStoredIds(ids) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
            }

            const checkboxes = document.querySelectorAll('.productCheckbox');
            let storedIds = getStoredIds();

            checkboxes.forEach(cb => {
                const id = parseInt(cb.value);
                if (storedIds.includes(id)) {
                    cb.checked = true;
                }

                cb.addEventListener('change', function () {
                    storedIds = getStoredIds();
                    if (this.checked) {
                        if (!storedIds.includes(id)) {
                            storedIds.push(id);
                        }
                    } else {
                        storedIds = storedIds.filter(item => item !== id);
                    }
                    setStoredIds(storedIds);
                    updateSelectAllState();
                });
            });

            const selectAll = document.getElementById('selectAll');
            if (selectAll) {
                selectAll.addEventListener('change', function (e) {
                    const isChecked = e.target.checked;
                    storedIds = getStoredIds();
                    checkboxes.forEach(cb => {
                        cb.checked = isChecked;
                        const id = parseInt(cb.value);
                        if (isChecked) {
                            if (!storedIds.includes(id)) storedIds.push(id);
                        } else {
                            storedIds = storedIds.filter(item => item !== id);
                        }
                    });
                    setStoredIds(storedIds);
                });
            }

            function updateSelectAllState() {
                if (!selectAll) return;
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                selectAll.checked = checkboxes.length > 0 && allChecked;
            }
            updateSelectAllState();

            const form = document.getElementById('inventoryForm');
            if (form) {
                form.addEventListener('submit', function () {
                    form.querySelectorAll('.hidden-selected-id').forEach(el => el.remove());

                    storedIds = getStoredIds();
                    storedIds.forEach(id => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'SelectedProductIds';
                        input.value = id;
                        input.className = 'hidden-selected-id';
                        form.appendChild(input);
                    });
                });
            }
        });
    </script>
}