@page "{id:int}"
@model Inventario_QR.Pages.VisualizationsModel
@{
    ViewData["Title"] = "Acta de Asignación - " + Model.Product.ProductName;
    Layout = null; // Elimina la barra de navegación, admin y cerrar sesión
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100">

    <div class="container" style="max-width: 750px;">
        <!-- Contenedor Único y Centrado -->
        <div class="card shadow-sm border-0 p-4 p-md-5 bg-white">

            <!-- Título Sutil -->
            <div class="text-center border-bottom pb-3 mb-4">
                <h4 class="fw-bold text-success mb-1">ACTA DE ASIGNACIÓN DE ACTIVOS Y EQUIPO</h4>
                <p class="text-muted small mb-0">Sistema de Inventario y Control QR</p>
            </div>

            <!-- Información General (Activo y Responsable Lado a Lado) -->
            <div class="row mb-4">
                <!-- Datos del Activo y Especificaciones Técnicas (Sin imagen de QR) -->
                <div class="col-md-6 border-end pe-md-4 mb-3 mb-md-0">
                    <h6 class="text-secondary border-bottom pb-2 fw-bold">📦 Datos del Activo</h6>
                    <div class="mt-2 small">
                        <p class="mb-1"><strong>Nombre:</strong> @Model.Product.ProductName</p>
                        <p class="mb-1"><strong>Código:</strong> @Model.Product.Code</p>
                        <p class="mb-2"><strong>QR ID:</strong> <code class="text-danger">@Model.Product.Qr</code></p>

                        <div class="mt-3 pt-2 border-top border-secondary">
                            <h6 class="text-dark fw-bold small mb-1">⚙️ Especificaciones Técnicas:</h6>
                            <ul class="list-unstyled small mb-0 text-dark">
                                @foreach (var item in Model.Items.Where(i => !i.Complement))
                                {
                                    <li class="mb-1"><strong>• @item.DetailName:</strong> @(string.IsNullOrEmpty(item.DetailsValue) ? "-" : item.DetailsValue)</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Datos del Responsable -->
                <div class="col-md-6 ps-md-4">
                    <h6 class="text-secondary border-bottom pb-2 fw-bold">👤 Datos del Responsable / Destino</h6>
                    <div class="small mt-2">
                        <p class="mb-1"><strong>Personal Asignado:</strong> @Model.Characteristic.PersonName</p>
                        <p class="mb-1"><strong>C.I.:</strong> @Model.Characteristic.PersonIdentification</p>
                        <p class="mb-1"><strong>Teléfono:</strong> @Model.Characteristic.PersonNumbers</p>
                        <p class="mb-1"><strong>Departamento:</strong> @Model.Characteristic.Localization</p>
                        <p class="mb-1"><strong>Fecha:</strong> @Model.Characteristic.Date.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>

            <!-- Tabla Solo para Accesorios / Complementos -->
            <div class="mb-3">
                <h6 class="text-secondary border-bottom pb-2 mb-3 fw-bold">📋 Accesorios y Complementos Entregados</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th class="text-dark">Accesorio / Elemento</th>
                                <th style="width: 20%;" class="text-center text-dark">Cantidad</th>
                                <th style="width: 40%;" class="text-dark">Observaciones / Serie</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any(i => i.Complement))
                            {
                                @foreach (var item in Model.Items.Where(i => i.Complement))
                                {
                                    <tr>
                                        <td><strong>@item.DetailName</strong></td>
                                        <td class="text-center">@item.Amount</td>
                                        <td>@(string.IsNullOrEmpty(item.DetailsValue) ? "-" : item.DetailsValue)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">No hay accesorios o complementos adicionales registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>