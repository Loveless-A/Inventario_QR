@page
@model Inventario_QR.Pages.ProductList
@{
    ViewData["Title"] = "Lista de Inventario General";
}

<div class="container-fluid mt-3">
    <!-- Encabezado y Botones de Navegación Superiores -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Lista de Inventario General</h2>
            <p class="text-muted small mb-0">Revisión de productos con características, complementos y casillas de control.</p>
        </div>
        <div class="d-flex gap-2 d-print-none">
            <a asp-page="/ProductList" class="btn btn-primary btn-sm shadow-sm">📋 Lista General</a>
            <a asp-page="/ProductAssignmentModel" class="btn btn-outline-secondary btn-sm shadow-sm">👤 Lista con Asignación</a>
            <button onclick="window.print();" class="btn btn-success btn-sm shadow-sm">📥 Descargar / Imprimir</button>
            <a asp-page="./Index" class="btn btn-outline-dark btn-sm shadow-sm">&larr; Volver al Panel</a>
        </div>
    </div>

    <!-- Barra de Filtros (Departamento y Búsqueda por Producto / Código) -->
    <form method="get" class="row g-3 mb-4 align-items-center d-print-none bg-light p-3 rounded-3 shadow-sm">
        <div class="col-auto">
            <label for="SelectedDepartment" class="col-form-label fw-bold small text-secondary">Filtrar por Departamento:</label>
        </div>
        <div class="col-auto">
            <select name="SelectedDepartment" class="form-select form-select-sm shadow-sm" onchange="this.form.submit()">
                <option value="">-- Todos los Departamentos --</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept" selected="@(Model.SelectedDepartment == dept ? "selected" : null)">@dept</option>
                }
            </select>
        </div>

        <div class="col-auto ms-md-3">
            <label for="SearchString" class="col-form-label fw-bold small text-secondary">Buscar Producto o Código:</label>
        </div>
        <div class="col-auto">
            <div class="input-group input-group-sm shadow-sm">
                <input type="text" name="SearchString" value="@Model.SearchString" class="form-control" placeholder="Escribe producto o código..." />
                <button type="submit" class="btn btn-outline-success">🔍 Buscar</button>
            </div>
        </div>
    </form>

    <!-- Tabla de Inventario General con el formato compacto unificado -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary text-center">
                        <tr>
                            <th class="py-3" style="width: 50px;">Nro</th>
                            <th class="py-3" style="width: 110px;">Código</th>
                            <th class="py-3" style="width: 320px;">Producto y Características</th>
                            <th class="py-3">Accesorios / Complementos</th>
                            <th class="py-3" style="width: 50px;">Cant.</th>
                            <th class="py-3" style="width: 250px;">Observación</th>
                            <th class="py-3" style="width: 30px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InventoryList != null && Model.InventoryList.Any())
                        {
                            @foreach (var item in Model.InventoryList)
                            {
                                var characteristics = item.Characteristics != null ? item.Characteristics.ToList() : new List<ProductList.DetailRowVm>();
                                var complements = item.Complements != null ? item.Complements.ToList() : new List<ProductList.DetailRowVm>();

                                int compCount = complements.Count;
                                int totalRows = compCount > 0 ? compCount : 1;
                                bool isFirstRow = true;

                                @if (compCount > 0)
                                {
                                    @foreach (var comp in complements)
                                    {
                                        <tr>
                                            @if (isFirstRow)
                                            {
                                                <td class="text-center fw-bold align-middle" rowspan="@totalRows">@item.RowNumber</td>
                                                <td class="align-middle text-center" rowspan="@totalRows"><strong class="text-primary">@item.Code</strong></td>

                                                <!-- PRODUCTO Y SUS CARACTERÍSTICAS PRINCIPALES JUNTAS EN UNA SOLA CELDA -->
                                                <td class="align-middle" rowspan="@totalRows">
                                                    <div class="fw-bold text-dark mb-1">@item.ProductName</div>
                                                    @if (characteristics.Any())
                                                    {
                                                        <div class="ps-2 border-start border-3 border-success text-muted small">
                                                            @foreach (var ch in characteristics)
                                                            {
                                                                <div><span class="fw-semibold">@ch.DetailName:</span> (Cant: @ch.Amount)</div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small fst-italic">Sin características</span>
                                                    }
                                                </td>

                                                isFirstRow = false;
                                            }

                                            <!-- ACCESORIOS EN FILAS SEPARADAS -->
                                            <td class="align-middle py-2">
                                                <span class="text-dark small">@comp.DetailName</span>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span class="badge bg-light text-dark border px-2">@comp.Amount</span>
                                            </td>
                                            <td class="align-middle">
                                                <div class="input-group input-group-sm">
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-text bg-white">
                                                        <input type="checkbox" class="form-check-input mt-0" title="Marcar como verificado" />
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    // CASO: PRODUCTO SIN ACCESORIOS
                                    <tr>
                                        <td class="text-center fw-bold align-middle">@item.RowNumber</td>
                                        <td class="align-middle text-center"><strong class="text-primary">@item.Code</strong></td>

                                        <td class="align-middle">
                                            <div class="fw-bold text-dark mb-1">@item.ProductName</div>
                                            @if (characteristics.Any())
                                            {
                                                <div class="ps-2 border-start border-3 border-success text-muted small">
                                                    @foreach (var ch in characteristics)
                                                    {
                                                        <div><span class="fw-semibold">@ch.DetailName:</span> (Cant: @ch.Amount)</div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Sin características</span>
                                            }
                                        </td>

                                        <td class="align-middle text-muted fst-italic text-center" colspan="4">Sin accesorios registrados.</td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <p class="mb-0">No hay productos registrados con los filtros seleccionados.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>