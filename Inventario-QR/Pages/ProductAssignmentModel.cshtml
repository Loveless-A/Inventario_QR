@page
@model Inventario_QR.Pages.ProductAssignmentModel
@{
    ViewData["Title"] = "Lista con Asignación de Productos";
}

<div class="container-fluid mt-3">
    <!-- Cabecera Responsiva -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Lista de Productos con Asignación</h2>
            <p class="text-muted small mb-0">Revisión de inventario con auditoría detallada por equipo.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/ProductList" class="btn btn-outline-secondary btn-sm">📋 Lista General</a>
            <a asp-page="/Privacy" class="btn btn-secondary btn-sm">👤 Asignación</a>
            <button onclick="window.print();" class="btn btn-success btn-sm">📥 Imprimir</button>
            <a asp-page="./Index" class="btn btn-outline-dark btn-sm">&larr; Volver</a>
        </div>
    </div>

    <!-- Filtros (Departamento y Búsqueda por Texto Libre sin botón limpiar) -->
    <form method="get" class="row g-3 mb-3 align-items-center d-print-none">
        <div class="col-auto">
            <label for="SelectedDepartment" class="col-form-label fw-bold small">Departamento:</label>
        </div>
        <div class="col-auto">
            <select name="SelectedDepartment" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Todos --</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept" selected="@(Model.SelectedDepartment == dept ? "selected" : null)">@dept</option>
                }
            </select>
        </div>

        <div class="col-auto ms-md-2">
            <label for="SearchString" class="col-form-label fw-bold small">Buscar (Personal / Producto / Código):</label>
        </div>
        <div class="col-auto">
            <div class="input-group input-group-sm">
                <input type="text" name="SearchString" value="@Model.SearchString" class="form-control" placeholder="Escribe para buscar..." />
                <button type="submit" class="btn btn-outline-success">🔍</button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary text-center">
                        <tr>
                            <th class="py-3" style="width: 50px;">Nro</th>
                            <th class="py-3" style="width: 110px;">Código</th>
                            <th class="py-3" style="width: 320px;">Producto, Características y Asignación</th>
                            <th class="py-3">Accesorios / Complementos</th>
                            <th class="py-3" style="width: 50px;">Cant.</th>
                            <th class="py-3" style="width: 250px;">Observación</th>
                            <th class="py-3" style="width: 30px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AssignmentList != null && Model.AssignmentList.Any())
                        {
                            @foreach (var item in Model.AssignmentList)
                            {
                                var characteristics = item.Characteristics != null ? item.Characteristics.ToList() : new List<ProductAssignmentModel.DetailRowVm>();
                                var complements = item.Complements != null ? item.Complements.ToList() : new List<ProductAssignmentModel.DetailRowVm>();

                                int compCount = complements.Count;
                                int totalRows = compCount > 0 ? compCount : 1;
                                bool isFirstRow = true;

                                @if (compCount > 0)
                                {
                                    @foreach (var comp in complements)
                                    {
                                        <tr>
                                            @if (isFirstRow)
                                            {
                                                <td class="text-center fw-bold align-middle" rowspan="@totalRows">@item.RowNumber</td>
                                                <td class="align-middle text-center" rowspan="@totalRows"><strong class="text-primary">@item.Code</strong></td>

                                                <td class="align-middle" rowspan="@totalRows">
                                                    <!-- Producto y características arriba -->
                                                    <div class="fw-bold text-dark mb-1">@item.ProductName</div>
                                                    @if (characteristics.Any())
                                                    {
                                                        <div class="ps-2 border-start border-3 border-success text-muted small mb-2">
                                                            @foreach (var ch in characteristics)
                                                            {
                                                                <div><span class="fw-semibold">@ch.DetailName:</span> @ch.DetailValue</div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted small fst-italic mb-2">Sin características</div>
                                                    }

                                                    <hr class="my-2 text-muted opacity-25" />

                                                    <!-- Asignación y ubicación abajo -->
                                                    <div>
                                                        @if (item.AssignedToName != "No asignado")
                                                        {
                                                            <div class="fw-bold text-success small">@item.AssignedToName</div>
                                                            @if (!string.IsNullOrEmpty(item.Localization))
                                                            {
                                                                <div class="text-muted small mt-1">📍 <em>@item.Localization</em></div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">No asignado</span>
                                                        }
                                                    </div>
                                                </td>

                                                isFirstRow = false;
                                            }

                                            <!-- ACCESORIOS EN FILAS SEPARADAS -->
                                            <td class="align-middle py-2">
                                                <span class="text-dark small">@comp.DetailName@(string.IsNullOrEmpty(comp.DetailValue) ? "" : $": {comp.DetailValue}")</span>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span class="badge bg-light text-dark border px-2">@comp.Amount</span>
                                            </td>
                                            <td class="align-middle">
                                                <div class="input-group input-group-sm">
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="input-group input-group-sm">
                                                    <div class="input-group-text bg-white">
                                                        <input type="checkbox" class="form-check-input mt-0" title="Marcar como verificado" />
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    // CASO: PRODUCTO SIN ACCESORIOS
                                    <tr>
                                        <td class="text-center fw-bold align-middle">@item.RowNumber</td>
                                        <td class="align-middle text-center"><strong class="text-primary">@item.Code</strong></td>

                                        <td class="align-middle">
                                            <!-- Producto y características arriba -->
                                            <div class="fw-bold text-dark mb-1">@item.ProductName</div>
                                            @if (characteristics.Any())
                                            {
                                                <div class="ps-2 border-start border-3 border-success text-muted small mb-2">
                                                    @foreach (var ch in characteristics)
                                                    {
                                                        <div><span class="fw-semibold">@ch.DetailName:</span> @ch.DetailValue</div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small fst-italic mb-2">Sin características</div>
                                            }

                                            <hr class="my-2 text-muted opacity-25" />

                                            <!-- Asignación y ubicación abajo -->
                                            <div>
                                                @if (item.AssignedToName != "No asignado")
                                                {
                                                    <div class="fw-bold text-success small">@item.AssignedToName</div>
                                                    @if (!string.IsNullOrEmpty(item.Localization))
                                                    {
                                                        <div class="text-muted small mt-1">📍 <em>@item.Localization</em></div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">No asignado</span>
                                                }
                                            </div>
                                        </td>

                                        <td class="align-middle text-muted fst-italic text-center" colspan="4">Sin accesorios registrados.</td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <p class="mb-0">No hay productos registrados que coincidan con la búsqueda.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>