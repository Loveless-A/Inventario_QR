# Copiar a .env y ajustar los valores.
#   cp .env.example .env
#
# Docker Compose lee este archivo automaticamente al arrancar.

# ----------------------------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------------------------
# Estos valores configuran el contenedor 'db' de este compose.
POSTGRES_DB=inventario_db
POSTGRES_USER=inventario

# OBLIGATORIO: cambiar esta contrasena. Generar una con:
#   openssl rand -base64 24
POSTGRES_PASSWORD=cambiame_por_una_clave_segura

# ----------------------------------------------------------------------------
# Conexion a la base de datos (opcional)
# ----------------------------------------------------------------------------
# Si la dejas vacia o la comentas, la aplicacion se conecta al contenedor
# 'db' de este mismo compose usando los valores POSTGRES_* de arriba.
#
# Decomentala solo si quieres apuntar a OTRA base de datos, por ejemplo un
# PostgreSQL instalado en el servidor donde corres las pruebas:
#
#   CONNECTION_STRING=Host=10.0.0.5;Port=5432;Database=inventario_db;Username=inventario;Password=clave
#
# Ojo: no puede contener comillas ni el caracter '#'.
# CONNECTION_STRING=
