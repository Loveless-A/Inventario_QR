# Copiar a .env y ajustar los valores.
#   cp .env.example .env
#
# Docker Compose lee este archivo automaticamente al arrancar.

# ----------------------------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------------------------
# Estos valores configuran el contenedor 'db' de este compose.
POSTGRES_DB=inventario_db
POSTGRES_USER=inventario

# OBLIGATORIO: cambiar esta contrasena. Generar una con:
#   openssl rand -base64 24
POSTGRES_PASSWORD=cambiame_por_una_clave_segura

# !!! IMPORTANTE: cambiar esta clave DESPUES del primer arranque NO hace nada.
#
# La imagen oficial de postgres solo lee POSTGRES_PASSWORD durante el primer
# initdb, y ese solo ocurre cuando el volumen esta vacio. Si ya existe
# (docker volume ls -> inventario-qr_db-data), editar el .env no cambia la
# clave y la app falla con:
#
#   FATAL: password authentication failed for user "inventario"
#
# Para cambiar la clave conservando los datos existentes:
#
#   NEW='TU_CLAVE_NUEVA'
#   docker compose exec -T db psql -U "$POSTGRES_USER" -d postgres -v pw="$NEW" <<'SQL'
#   ALTER USER CURRENT_USER WITH PASSWORD :'pw';
#   SQL
#
# Ojo: el <<'SQL' es obligatorio. Con psql -c las variables -v NO se
# interpolan y el comando falla con un error de sintaxis en :'pw'.
#
# O bien empezar de cero (BORRA todos los datos):
#
#   docker compose down -v && docker compose up -d

# ----------------------------------------------------------------------------
# Conexion a la base de datos (opcional)
# ----------------------------------------------------------------------------
# Si la dejas vacia o la comentas, la aplicacion se conecta al contenedor
# 'db' de este mismo compose usando los valores POSTGRES_* de arriba.
#
# Decomentala solo si quieres apuntar a OTRA base de datos, por ejemplo un
# PostgreSQL instalado en el servidor donde corres las pruebas:
#
#   CONNECTION_STRING=Host=10.0.0.5;Port=5432;Database=inventario_db;Username=inventario;Password=clave
#
# Ojo: no puede contener comillas ni el caracter '#'.
# CONNECTION_STRING=
